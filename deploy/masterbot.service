# ────────────────────────────────────────────────────────────────────
#  systemd unit — Master Hosting Bot
#
#  1. Edit the two placeholders below: __USER__ and the path if different.
#  2. Install:
#       sudo cp deploy/masterbot.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now masterbot
#  3. Logs:
#       journalctl -u masterbot -f
# ────────────────────────────────────────────────────────────────────
[Unit]
Description=Master Hosting Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/home/__USER__/MasterBot
EnvironmentFile=/home/__USER__/MasterBot/.env
ExecStart=/home/__USER__/MasterBot/venv/bin/python main.py
Restart=always
RestartSec=5
# Don't let one runaway child bot subprocess take the whole host down.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
