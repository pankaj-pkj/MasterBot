# ────────────────────────────────────────────────────────────────────
#  systemd unit — Master Hosting Bot
#
#  Install (run install_service.sh — it fills the placeholders for you):
#       ./deploy/install_service.sh
#
#  Or manually (note: root's home is /root, NOT /home/root):
#       sudo cp deploy/masterbot.service /etc/systemd/system/
#       sudo sed -i "s|__USER__|$USER|g; s|__DIR__|$PWD|g" \
#            /etc/systemd/system/masterbot.service
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now masterbot
#
#  Logs:
#       journalctl -u masterbot -f
# ────────────────────────────────────────────────────────────────────
[Unit]
Description=Master Hosting Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/venv/bin/python main.py
Restart=always
RestartSec=5
# Don't let one runaway child bot subprocess take the whole host down.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
